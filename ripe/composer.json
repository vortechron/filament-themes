{
    "name": "vortechron/filament-ripe",
    "description": "Stripe-dashboard inspired theme for FilamentPHP 5 panels.",
    "type": "library",
    "keywords": [
        "filament",
        "laravel",
        "theme",
        "stripe",
        "dashboard",
        "ui"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Vortechron"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "autoload": {
        "psr-4": {
            "Vortechron\\FilamentRipe\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortechron\\FilamentRipe\\RipeServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/vortechron/filament-themes/issues",
        "source": "https://github.com/vortechron/filament-themes/tree/main/ripe"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
