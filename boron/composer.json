{
    "name": "vortechron/filament-boron",
    "description": "Boron admin theme for FilamentPHP 5 — a neubrutalist Lexend look with warm cream surfaces, sage accents and hard offset shadows.",
    "type": "library",
    "keywords": [
        "filament",
        "filamentphp",
        "theme",
        "boron",
        "laravel",
        "tailwind"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Vortechron"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "autoload": {
        "psr-4": {
            "Vortechron\\FilamentBoron\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortechron\\FilamentBoron\\BoronServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/vortechron/filament-themes/issues",
        "source": "https://github.com/vortechron/filament-themes/tree/main/boron"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
