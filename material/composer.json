{
    "name": "vortechron/filament-material",
    "description": "Material Design 3 theme for FilamentPHP 5 panels — baseline tonal palette, Roboto type scale, state layers and Material shape and elevation.",
    "type": "library",
    "keywords": [
        "filament",
        "filamentphp",
        "theme",
        "material",
        "material-design",
        "laravel",
        "ui"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Vortechron"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "autoload": {
        "psr-4": {
            "Vortechron\\FilamentMaterial\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortechron\\FilamentMaterial\\MaterialServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/vortechron/filament-themes/issues",
        "source": "https://github.com/vortechron/filament-themes/tree/main/material"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
