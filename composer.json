{
    "name": "vortechron/filament-themes",
    "description": "Production-ready themes for FilamentPHP 5 panels.",
    "type": "library",
    "keywords": [
        "filament",
        "filamentphp",
        "laravel",
        "theme"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Vortechron"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15"
    },
    "autoload": {
        "psr-4": {
            "Vortechron\\FilamentBoron\\": "boron/src/",
            "Hasnayeen\\Themes\\": "hasnayeen/src/",
            "Ripe\\Theme\\": "ripe/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vortechron\\FilamentBoron\\FilamentBoronServiceProvider",
                "Hasnayeen\\Themes\\ThemesServiceProvider",
                "Ripe\\Theme\\RipeThemeServiceProvider"
            ]
        }
    },
    "support": {
        "issues": "https://github.com/vortechron/filament-themes/issues",
        "source": "https://github.com/vortechron/filament-themes"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

